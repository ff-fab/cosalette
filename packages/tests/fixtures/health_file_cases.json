{
  "_comment": "Golden health file cases shared by the Python check (pytest) and the Rust probe (cargo test). Each case writes `json` (serialised) or `text` (verbatim) to a file, or leaves it `missing`, then checks it at Unix time `now`. `{path}` in `reason`/`reason_prefix` stands for the file path. See docs/reference/health-file.md.",
  "cases": [
    {
      "name": "missing file",
      "missing": true,
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} does not exist"
    },
    {
      "name": "empty file",
      "text": "",
      "now": 1000000,
      "healthy": false,
      "reason_prefix": "health file {path} is unreadable: "
    },
    {
      "name": "truncated JSON",
      "text": "{\"written_at\": 999990",
      "now": 1000000,
      "healthy": false,
      "reason_prefix": "health file {path} is unreadable: "
    },
    {
      "name": "trailing garbage",
      "text": "{\"written_at\": 999990} x",
      "now": 1000000,
      "healthy": false,
      "reason_prefix": "health file {path} is unreadable: "
    },
    {
      "name": "NaN token is not JSON",
      "text": "{\"written_at\": NaN}",
      "now": 1000000,
      "healthy": false,
      "reason_prefix": "health file {path} is unreadable: "
    },
    {
      "name": "Infinity token is not JSON",
      "text": "{\"written_at\": Infinity}",
      "now": 1000000,
      "healthy": false,
      "reason_prefix": "health file {path} is unreadable: "
    },
    {
      "name": "overflowing float is not JSON",
      "text": "{\"written_at\": 1e400}",
      "now": 1000000,
      "healthy": false,
      "reason_prefix": "health file {path} is unreadable: "
    },
    {
      "name": "integer above u64 range is parsed as finite number",
      "text": "{\"written_at\": 999990, \"interval\": 18446744073709551616}",
      "now": 1000000,
      "healthy": true,
      "reason": "healthy (health file 10s old)"
    },
    {
      "name": "maximum u64 integer is valid JSON",
      "text": "{\"written_at\": 999990, \"unknown\": 18446744073709551615}",
      "now": 1000000,
      "healthy": true,
      "reason": "healthy (health file 10s old)"
    },
    {
      "name": "minimum i64 integer is valid JSON",
      "text": "{\"written_at\": 999990, \"unknown\": -9223372036854775808}",
      "now": 1000000,
      "healthy": true,
      "reason": "healthy (health file 10s old)"
    },
    {
      "name": "integer below i64 range is parsed as finite number",
      "text": "{\"written_at\": 999990, \"interval\": -9223372036854775809}",
      "now": 1000000,
      "healthy": true,
      "reason": "healthy (health file 10s old)"
    },
    {
      "name": "integer too large for finite number is not JSON",
      "text": "{\"written_at\": 999990, \"unknown\": }",
      "now": 1000000,
      "healthy": false,
      "reason_prefix": "health file {path} is unreadable: "
    },
    {
      "name": "UTF-8 BOM",
      "text": "﻿{\"written_at\": 999990}",
      "now": 1000000,
      "healthy": false,
      "reason_prefix": "health file {path} is unreadable: "
    },
    {
      "name": "top-level array",
      "json": [
        1,
        2
      ],
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} is not a JSON object"
    },
    {
      "name": "top-level null",
      "text": "null",
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} is not a JSON object"
    },
    {
      "name": "top-level number",
      "text": "999990",
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} is not a JSON object"
    },
    {
      "name": "version absent means 1",
      "json": {
        "written_at": 999990
      },
      "now": 1000000,
      "healthy": true,
      "reason": "healthy (health file 10s old)"
    },
    {
      "name": "version 1",
      "json": {
        "health_file_version": 1,
        "written_at": 999990
      },
      "now": 1000000,
      "healthy": true,
      "reason": "healthy (health file 10s old)"
    },
    {
      "name": "version 2 is unsupported",
      "json": {
        "health_file_version": 2,
        "written_at": 999990
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has unsupported version 2"
    },
    {
      "name": "version 0 is unsupported",
      "json": {
        "health_file_version": 0,
        "written_at": 999990
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has unsupported version 0"
    },
    {
      "name": "version -1 is unsupported",
      "json": {
        "health_file_version": -1,
        "written_at": 999990
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has unsupported version -1"
    },
    {
      "name": "version float 1.0 is invalid",
      "text": "{\"health_file_version\": 1.0, \"written_at\": 999990}",
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has an invalid version"
    },
    {
      "name": "version string is invalid",
      "json": {
        "health_file_version": "1",
        "written_at": 999990
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has an invalid version"
    },
    {
      "name": "version bool is invalid",
      "json": {
        "health_file_version": true,
        "written_at": 999990
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has an invalid version"
    },
    {
      "name": "version null is invalid",
      "json": {
        "health_file_version": null,
        "written_at": 999990
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has an invalid version"
    },
    {
      "name": "version is checked before written_at",
      "json": {
        "health_file_version": 2
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has unsupported version 2"
    },
    {
      "name": "written_at missing",
      "json": {
        "interval": 60
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has no written_at time"
    },
    {
      "name": "written_at null",
      "json": {
        "written_at": null
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has no written_at time"
    },
    {
      "name": "written_at bool",
      "json": {
        "written_at": true
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has no written_at time"
    },
    {
      "name": "written_at string",
      "json": {
        "written_at": "999990"
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has no written_at time"
    },
    {
      "name": "written_at object",
      "json": {
        "written_at": {}
      },
      "now": 1000000,
      "healthy": false,
      "reason": "health file {path} has no written_at time"
    },
    {
      "name": "written_at integer",
      "text": "{\"written_at\": 999990}",
      "now": 1000000,
      "healthy": true,
      "reason": "healthy (health file 10s old)"
    },
    {
      "name": "written_at float",
      "text": "{\"written_at\": 999989.75}",
      "now": 1000000,
      "healthy": true,
      "reason": "healthy (health file 10s old)"
    },
    {
      "name": "written_at in the future (clock skew)",
      "json": {
        "written_at": 1000005
      },
      "now": 1000000,
      "healthy": true,
      "reason": "healthy (health file -5s old)"
    },
    {
      "name": "duplicate key: last wins",
      "text": "{\"written_at\": 0, \"written_at\": 999990}",
      "now": 1000000,
      "healthy": true,
      "reason": "healthy (health file 10s old)"
    },
    {
      "name": "default interval: age at limit 180",
      "json": {
        "written_at": 999820
      },
      "now": 1000000,
      "healthy": true,
