"""{{ device_name }} — cosalette telemetry device.

Reads sensor data and publishes it as MQTT telemetry at a fixed interval.
{% if adapter_port %}
Uses dependency injection to access hardware via the {{ adapter_port }} port protocol.
{% endif %}

Usage: run directly, or import ``app`` (or a ``Router``) into your composition root.
"""

from __future__ import annotations
{% if adapter_port %}

from {{ adapter_module }} import {{ adapter_port }}
{% endif %}

import cosalette

app = cosalette.App(name="myapp", version="0.1.0")  # TODO: adjust name and version

# For multi-module apps, consider using Router instead:
# router = cosalette.Router(prefix="{{ device_name }}", tags=["sensors"])
# Then: app.include_router(router) in main.py
# See: cosalette ai help router
{% if adapter_port %}

# Register the adapter — swap {{ dry_run_name }} for {{ impl_name }} in production
# from {{ adapter_module }} import {{ impl_name }}, {{ dry_run_name }}
# app.adapter({{ adapter_port }}, {{ dry_run_name }})
{% endif %}


@app.telemetry("{{ device_name }}", interval={{ interval }})  # TODO: adjust interval
async def {{ func_name }}(ctx: cosalette.DeviceContext) -> dict[str, object]:
    """Read {{ device_name }} sensor data and return telemetry payload.
{% if adapter_port %}

    The ``{{ adapter_port }}`` adapter is injected by the framework via
    ``ctx.adapter()`` — see ADR-006 (hexagonal architecture).
{% endif %}

    Returns:
        Dictionary of sensor readings. The framework serialises this to JSON
        and publishes it to ``<app_name>/{{ device_name }}/state``, where
        ``<app_name>`` is the configured ``app.name`` value.

    Tip:
        For typed contracts, annotate the return type with a Pydantic model
        and add ``state_model`` to the decorator. The framework will validate
        and serialize automatically.

        Example:
            from pydantic import BaseModel

            class Reading(BaseModel):
                value: float
                unit: str = "celsius"

            @app.telemetry("{{ device_name }}", interval={{ interval }}, state_model=Reading)
            async def {{ func_name }}(ctx: DeviceContext) -> Reading:
                return Reading(value=22.5)

        See: cosalette ai help contracts
    """
{% if adapter_port %}
    sensor = ctx.adapter({{ adapter_port }})
    reading = sensor.read()
{% endif %}
    return {
{% if adapter_port %}
        "value": reading,
{% else %}
        "value": 0,  # TODO: replace with actual sensor reading
{% endif %}
    }


