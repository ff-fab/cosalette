class TestDevice{{ device_name_pascal }}Integration:
    """Integration tests using AppHarness."""

    async def test_publishes_telemetry(self) -> None:
        """Full lifecycle publishes at least one {{ device_name }} reading."""
        import asyncio

        harness = cosalette.testing.AppHarness.create(name="testapp")
{% if adapter_port %}
        harness.app.adapter({{ adapter_port }}, {{ dry_run_name }})
{% endif %}

        from {{ device_module }} import {{ func_name }}

        harness.app.telemetry("{{ device_name }}", interval=1)({{ func_name }})

        async def _shutdown() -> None:
            await asyncio.sleep(0.1)
            harness.trigger_shutdown()

        asyncio.create_task(_shutdown())
        await harness.run()

        messages = harness.mqtt.get_messages_for("testapp/{{ device_name }}/state")
        assert len(messages) >= 1
