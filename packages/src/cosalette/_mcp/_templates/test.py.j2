class TestDevice{{ device_name_pascal }}:
    """Unit tests for the {{ device_name }} device handler."""

    async def test_returns_expected_keys(self, app: cosalette.App) -> None:
        """Handler returns a dict with the expected telemetry keys."""
        from {{ device_module }} import {{ func_name }}

        # Register the device so the framework wires DI
        app.telemetry("{{ device_name }}", interval=60)({{ func_name }})
        snapshot = cosalette.build_registry_snapshot(app)

        assert any(t["name"] == "{{ device_name }}" for t in snapshot["telemetry"])


