class TestDevice{{ device_name_pascal }}:
    """Unit tests for the {{ device_name }} device handler."""

    async def test_returns_expected_keys(self, app: cosalette.App) -> None:
        """Handler returns a dict with the expected telemetry keys."""
        snapshot = cosalette.build_registry_snapshot(app)

        assert any(t["name"] == "{{ device_name }}" for t in snapshot["telemetry"])


# ---------------------------------------------------------------------------
# Integration tests — AppHarness
# ---------------------------------------------------------------------------

class TestDevice{{ device_name_pascal }}Integration:
    """Integration tests using AppHarness."""

    @pytest.fixture
    def harness(self) -> cosalette.testing.AppHarness:
        """Minimal harness with {{ device_name }} registered at fast interval."""
        _harness = cosalette.testing.AppHarness.create(name="testapp")
{% if adapter_port %}
        _harness.app.adapter({{ adapter_port }}, {{ dry_run_name }})
{% endif %}
        # Use interval=1 for speed in integration tests.
        _harness.app.telemetry("{{ device_name }}", interval=1)({{ func_name }})
        return _harness

    async def test_publishes_telemetry(
        self, harness: cosalette.testing.AppHarness
    ) -> None:
        """Full lifecycle publishes at least one {{ device_name }} reading."""
        async def _shutdown() -> None:
            await asyncio.sleep(0.1)
            harness.trigger_shutdown()

        asyncio.create_task(_shutdown())
        await harness.run()

        messages = harness.mqtt.get_messages_for("testapp/{{ device_name }}/state")
        assert len(messages) >= 1
