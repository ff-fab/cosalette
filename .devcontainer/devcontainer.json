{
  "name": "cosalette",
  "build": {
    "dockerfile": "Dockerfile",
    "cacheFrom": "ghcr.io/ff-fab/cosalette-devcontainer"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:/workspace/packages/.venv/bin:${containerEnv:PATH}",
    "UV_LINK_MODE": "copy",
    "GH_PAGER": "cat",
    "CONTEXT7_API_KEY": "${localEnv:CONTEXT7_API_KEY}"
  },

  "customizations": {
    "vscode": {
      "settings": {
        // Python interpreter in container
        "python.defaultInterpreterPath": "/workspace/packages/.venv/bin/python",
        "python.terminal.activateEnvironment": true,

        // Line length: 88 characters (matches Prettier, Ruff, and Black conventions)
        "editor.rulers": [88],
        "editor.wordWrap": "off",

        // Default formatter for different file types
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,

        // Python formatting and linting
        "[python]": {
          "editor.rulers": [88],
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },

        // TypeScript/JavaScript formatting
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },

        // JSON formatting
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },

        // Markdown formatting (Prettier, not Markdown All in One)
        "[markdown]": {
          "editor.wordWrap": "on",
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },

        // Disable Markdown All in One's formatter (conflicts with Prettier)
        "markdown.extension.formatting.enable": false,
        "markdown.extension.preview.autoShow": false,

        // YAML formatting
        "[yaml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },

        // File consistency
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true,

        // Python linting
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.linting.mypyEnabled": true,
        "python.analysis.typeCheckingMode": "strict",
        "python.analysis.extraPaths": ["packages/src", "packages"],

        // Python testing (pytest)
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": ["tests", "-v", "--tb=short"],
        "python.testing.cwd": "${workspaceFolder}/packages",

        // Coverage Gutters - gutter icons + subtle ruler indicators
        "coverage-gutters.coverageFileNames": [
          "coverage.xml",
          "lcov.info",
          "coverage/lcov.info"
        ],
        "coverage-gutters.showGutterCoverage": true,
        "coverage-gutters.showLineCoverage": false,
        "coverage-gutters.showRulerCoverage": true,
        // Theme-matched colors: green (comments) = covered, orange (strings) = uncovered
        // Gutter uses full opacity, ruler uses subtle 0.3 opacity
        "coverage-gutters.highlightdark": "rgba(106, 153, 85, 0.3)",
        "coverage-gutters.highlightlight": "rgba(106, 153, 85, 0.3)",
        "coverage-gutters.noHighlightDark": "rgba(206, 145, 120, 0.3)",
        "coverage-gutters.noHighlightLight": "rgba(206, 145, 120, 0.3)",

        // Search and exclude patterns
        "search.exclude": {
          "**/__pycache__": true,
          "**/node_modules": true,
          "**/dist": true,
          "**/.venv": true,
          "**/.ty_cache": true,
          "**/build": true
        },

        // Hide intermediate coverage files
        "files.exclude": {
          "**/.coverage": true,
          "**/coverage.xml": true
        },

        // Show gitignored files like htmlcov/ in explorer
        "explorer.excludeGitIgnore": false,

        // GitHub integrations
        "github.gitAuthentication": true,
        "githubPullRequests.remotes": ["cosalette", "origin", "upstream"],

        // Beads: bd is baked into the image so the extension can discover
        // the project on first startup before post-create finishes.
        "beads.autoStartDaemon": true,

        // window title
        "window.title": "cosalette [devcontainer]",

        // Window theming – PyPI and Python brand colors
        "workbench.colorCustomizations": {
          // Title bar: Amber primary (matches zensical docs header)
          "titleBar.activeBackground": "#1A1A1A",
          "titleBar.activeForeground": "#FFB300",
          "titleBar.inactiveBackground": "#1A1A1A",
          "titleBar.inactiveForeground": "#ffb30093",

          // Activity bar: Slate dark with amber/orange accents
          "activityBar.background": "#303030",
          "activityBar.foreground": "#FFB300",
          "activityBar.inactiveForeground": "#9E9E9E",
          "activityBar.activeBorder": "#FF9100",
          "activityBarBadge.background": "#FF9100",
          "activityBarBadge.foreground": "#FFFFFF"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "anthropic.claude-code",
        "vivaxy.vscode-conventional-commits",
        "ryanluker.vscode-coverage-gutters",
        "task.vscode-task",
        "planet57.vscode-beads",
        "github.vscode-pull-request-github"
      ]
    }
  },

  "postCreateCommand": ".devcontainer/post-create.sh",
  "postStartCommand": ".devcontainer/post-start.sh",

  "remoteUser": "vscode",

  // Required for Docker-in-Docker: mount syscalls (securityfs, tmpfs, cgroup nesting)
  // need elevated kernel privileges. Previously provided automatically by the
  // ghcr.io/devcontainers/features/docker-in-docker:2 feature metadata; now explicit.
  "privileged": true,

  // Mount /var/lib/docker as a named volume so it sits on a native filesystem
  // (ext4), not on the container's overlayfs layer. This is the same mount that
  // ghcr.io/devcontainers/features/docker-in-docker:2 provided via its feature
  // metadata. Without it, the inner Docker daemon tries overlay-on-overlay, which
  // fails with EINVAL on GitHub Actions runners.
  "mounts": [
    {
      "source": "dind-var-lib-docker-${devcontainerId}",
      "target": "/var/lib/docker",
      "type": "volume"
    }
  ]
}
