{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 9am on monday"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "dependencyDashboard": true,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Group Python minor+patch updates — reviewed (not automerged) with a 7-day cooldown; these ship to the fleet in the wheel",
      "matchManagers": ["uv"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-deps",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "pre-commit-hooks"
    },
    {
      "description": "Group GitHub Actions minor+patch updates — reviewed (not automerged) with a 7-day cooldown; these run in the release pipeline (id-token/contents write)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github-actions",
      "automerge": false,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Major version bumps get individual PRs (may need code changes)",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "All Dockerfile updates require manual review (supply-chain verification)",
      "matchManagers": ["dockerfile"],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": ["before 9am on monday"]
  },
  "pip_requirements": {
    "description": "Track the hash-pinned CI build-tool requirements (e.g. maturin)",
    "fileMatch": ["^\\.github/requirements/[^/]+\\.txt$"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "regexManagers": [
    {
      "description": "Track hadolint version in qa-task.sh",
      "fileMatch": ["^scripts/qa-task\\.sh$"],
      "matchStrings": [
        "HADOLINT_VERSION=\"\\$\\{HADOLINT_VERSION:-(?<currentValue>[^\"]+)\\}\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/hadolint/hadolint",
      "versioningTemplate": "docker"
    },
    {
      "description": "Track Trivy version in qa-task.sh",
      "fileMatch": ["^scripts/qa-task\\.sh$"],
      "matchStrings": [
        "TRIVY_VERSION=\"\\$\\{TRIVY_VERSION:-(?<currentValue>[^\"]+)\\}\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "aquasec/trivy",
      "versioningTemplate": "docker"
    }
  ]
}
