{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "schedule": ["before 9am on monday"],
  "timezone": "Europe/Berlin",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "description": "Group all Python minor+patch updates",
      "matchManagers": ["uv"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python-deps",
      "automerge": true
    },
    {
      "description": "Group all pre-commit hook updates",
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "pre-commit-hooks",
      "automerge": true
    },
    {
      "description": "Group all GitHub Actions minor+patch updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Major version bumps get individual PRs (may need code changes)",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "All Dockerfile updates require manual review (supply-chain verification)",
      "matchManagers": ["dockerfile"],
      "automerge": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": ["before 9am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"]
  },
  "regexManagers": [
    {
      "description": "Track hadolint version in qa-task.sh",
      "fileMatch": ["^scripts/qa-task\\.sh$"],
      "matchStrings": [
        "HADOLINT_VERSION=\"\\$\\{HADOLINT_VERSION:-(?<currentValue>[^\"]+)\\}\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/hadolint/hadolint",
      "versioningTemplate": "docker"
    },
    {
      "description": "Track Trivy version in qa-task.sh",
      "fileMatch": ["^scripts/qa-task\\.sh$"],
      "matchStrings": [
        "TRIVY_VERSION=\"\\$\\{TRIVY_VERSION:-(?<currentValue>[^\"]+)\\}\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "aquasec/trivy",
      "versioningTemplate": "docker"
    }
  ]
}
